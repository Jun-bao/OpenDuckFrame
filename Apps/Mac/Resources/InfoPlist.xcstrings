    "NSScreenCaptureUsageDescription": {
      "comment": "Privacy prompt purpose: capturing the selected window or display",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDuckFrame zeigt und verbessert das ausgewählte Fenster oder den ausgewählten Bildschirm. Die Aufnahme bleibt auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDuckFrame shows and enhances the window or display you select. Capture stays on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDuckFrame muestra y mejora la ventana o pantalla que selecciones. La captura se queda en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDuckFrame affiche et améliore la fenêtre ou l’écran que vous sélectionnez. La capture reste sur ce Mac."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDuckFrame menampilkan dan meningkatkan jendela atau layar yang Anda pilih. Tangkapan tetap berada di Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDuckFrame mostra e migliora la finestra o lo schermo selezionato. L’acquisizione resta su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDuckFrame は選択したウインドウまたはディスプレイを表示して画質を向上させます。キャプチャはこの Mac の中だけで処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDuckFrame은 선택한 윈도우나 디스플레이를 표시하고 화질을 향상합니다. 캡처한 화면은 이 Mac에만 남습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDuckFrame toont en verbetert het venster of scherm dat je kiest. De opname blijft op deze Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDuckFrame wyświetla i ulepsza wybrane okno lub ekran. Przechwytywany obraz pozostaje na tym Macu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O OpenDuckFrame mostra e melhora a janela ou o monitor que você selecionar. A captura fica neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDuckFrame показывает и улучшает выбранное окно или дисплей. Захваченное изображение остаётся на этом Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDuckFrame จะแสดงและปรับปรุงภาพของหน้าต่างหรือจอภาพที่คุณเลือก ภาพที่จับได้จะอยู่ใน Mac เครื่องนี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDuckFrame seçtiğiniz pencereyi veya ekranı gösterir ve iyileştirir. Yakalanan görüntü bu Mac’te kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDuckFrame hiển thị và cải thiện cửa sổ hoặc màn hình bạn chọn. Hình ảnh ghi lại chỉ ở trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDuckFrame 会显示并增强你选择的窗口或显示器画面。采集的画面只留在这台 Mac 上。"
          }
        },
